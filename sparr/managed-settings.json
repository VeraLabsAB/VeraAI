{
  "requiredMinimumVersion": "2.1.305",
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "disableSkillShellExecution": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [],
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "allowAppleEvents": false,
    "allowNestedUserNamespaces": false,
    "network": {
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyWrite": [
        "/Applications/Claude.app",
        "~/Library/Application Support/Claude/claude-code",
        "~/.local/share/claude"
      ],
      "denyRead": ["~/.ssh"]
    }
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(su)",
      "Read(~/.ssh/**)",
      "Edit(//**/.git/**)",
      "Edit(//**/.git)",
      "Edit(//**/.ugrep)",
      "Edit(~/.ugrep)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogin)",
      "Edit(~/.zlogout)",
      "Edit(//etc/zshenv)",
      "Edit(//etc/zprofile)",
      "Edit(//etc/zshrc)",
      "Edit(//etc/zshrc_*)",
      "Edit(//etc/zlogin)",
      "Edit(//etc/zlogout)",
      "Edit(~/.zshrc.zwc)",
      "Edit(~/.zshenv.zwc)",
      "Edit(~/.zprofile.zwc)",
      "Edit(~/.zlogin.zwc)",
      "Edit(~/.zlogout.zwc)",
      "Edit(//etc/zshenv.zwc)",
      "Edit(//etc/zprofile.zwc)",
      "Edit(//etc/zshrc.zwc)",
      "Edit(//etc/zlogin.zwc)",
      "Edit(//etc/zlogout.zwc)",
      "Edit(~/.nvm/**)",
      "Edit(~/.zkbd/**)",
      "Edit(~/.zsh_sessions/**)",
      "Edit(~/.zcompdump)",
      "Edit(~/.zcompdump*)",
      "Edit(~/.zcompdump.zwc)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.claude/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.ssh/**)",
      "Edit(//**/.mcp.json)",
      "Edit(//**/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/bin/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.local/bin/claude)",
      "Edit(~/.local/share/claude/**)",
      "Edit(~/Library/Application Support/Claude/claude-code/**)",
      "Edit(~/Library/Application Support/Claude/**)",
      "Edit(//Applications/Claude.app/**)",
      "Edit(//opt/homebrew/**)",
      "Edit(//**/.venv/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Developer/CommandLineTools/usr/bin/python3",
            "args": ["-I", "-S", "/Library/Application Support/ClaudeCode/vera/kommandosparr.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
