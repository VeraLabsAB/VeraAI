{
  "requiredMinimumVersion": "2.1.295",
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "disableSkillShellExecution": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(su)",
      "Edit(//**/.git/**)",
      "Edit(//**/.git)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogin)",
      "Edit(~/.zlogout)",
      "Edit(//etc/zshenv)",
      "Edit(//etc/zprofile)",
      "Edit(//etc/zshrc)",
      "Edit(//etc/zshrc_*)",
      "Edit(//etc/zlogin)",
      "Edit(//etc/zlogout)",
      "Edit(~/.nvm/**)",
      "Edit(~/.zkbd/**)",
      "Edit(~/.zsh_sessions/**)",
      "Edit(~/.zcompdump)",
      "Edit(~/.zcompdump*)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.claude/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.ssh/**)",
      "Edit(//**/.mcp.json)",
      "Edit(//**/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/bin/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.local/bin/claude)",
      "Edit(~/.local/share/claude/**)",
      "Edit(~/Library/Application Support/Claude/claude-code/**)",
      "Edit(~/Library/Application Support/Claude/**)",
      "Edit(//Applications/Claude.app/**)",
      "Edit(//opt/homebrew/**)",
      "Edit(//**/.venv/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["-I", "/Library/Application Support/ClaudeCode/vera/kommandosparr.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
